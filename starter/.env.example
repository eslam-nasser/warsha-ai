# Copy to .env.local for local work. Set the same names in Vercel for each environment.
# Each product gets separate preview, staging and production values. Build agents never get production values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry: one project per product
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog: one project per product
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase: database, login and storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pooler URL, port 6543
DATABASE_URL=
