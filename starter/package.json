{
  "name": "warsha-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:messages": "node scripts/check-messages.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "npm run lint && npm run lint:messages && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/nextjs": "11.11.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "postgres": "4.1.0",
    "posthog-js": "1.447.3",
    "posthog-node": "5.63.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-i18next": "6.1.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "@rolldown/binding-win32-x64-msvc": "1.2.19"
  }
}
